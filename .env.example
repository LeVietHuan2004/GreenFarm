MYSQL_ROOT_PASSWORD=greenfarm
MYSQL_PORT=3307
BACKEND_PORT=8080
PAYMENT_FRONTEND_RESULT_URL=http://localhost:3000/payment-result
PAYMENT_EXPIRATION_SCAN_MS=60000
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
VNPAY_RETURN_URL=

STOREFRONT_URL=http://localhost:3000
INVOICE_EMAIL_ENABLED=false
INVOICE_EMAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
INVOICE_EMAIL_MAX_ATTEMPTS=5
INVOICE_EMAIL_BASE_RETRY_MINUTES=2
INVOICE_EMAIL_RETRY_SCAN_MS=60000

# Set all three Cloudinary values to store new images in Cloudinary.
# When all three are empty, uploads continue using the local Docker volume.
# Keep these server-side; never use NEXT_PUBLIC_ for the API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local storage remains available for existing images and development without Cloudinary.
UPLOAD_DIRECTORY=uploads
UPLOAD_MAX_IMAGE_BYTES=5242880

# JWT session rotation
JWT_REFRESH_EXPIRATION_DAYS=30
GUEST_SESSION_DAYS=30
INVENTORY_EXPIRY_WARNING_DAYS=3
INVENTORY_EXPIRY_SCAN_MS=60000
